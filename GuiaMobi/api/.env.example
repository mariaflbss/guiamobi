# Ambiente
NODE_ENV=development
PORT=3333

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guiamobi?schema=public"

# JWT
JWT_SECRET="troque-este-valor-por-um-segredo-forte-em-producao"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_RESET_EXPIRES_IN="30m"

# CORS - origens permitidas separadas por vírgula (use * apenas em desenvolvimento)
CORS_ORIGIN="*"

# E-mail (recuperação de senha) - SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GuiaMobi Acessível <no-reply@guiamobi.com>"

# URL do app mobile usada no link de redefinição de senha (deep link)
APP_RESET_PASSWORD_URL="guiamobi://redefinir-senha"

# Busca de endereços (Nominatim/OpenStreetMap). A política de uso do serviço público
# exige identificar a aplicação: informe um e-mail ou site de contato do projeto.
# Para uso intenso, aponte GEOCODING_BASE_URL para uma instância própria.
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODING_CONTACT=""

# Origem dos dados de linhas exibida em /transit/status ("seed" = dados de demonstração)
TRANSIT_DATA_SOURCE="seed"
