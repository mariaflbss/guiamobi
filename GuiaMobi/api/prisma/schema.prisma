// Schema do banco de dados da API do GuiaMobi Acessível
// Sprint 1: apenas os modelos necessários para autenticação (US01)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuário do aplicativo
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  // Avatar escolhido no perfil (id de uma lista fixa no app, ex.: "cat"); opcional
  avatarId     String?  @map("avatar_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Token de recuperação de senha (US01 - "Recuperação de senha por e-mail")
// O token é enviado por e-mail e usado uma única vez para redefinir a senha.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash") // nunca armazenar o token em texto puro
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Dados de transporte (Prioridade 1 da revisão): linhas e paradas de ônibus.
// Este é o tipo de dado que "realmente precisa de servidor" citado na
// arquitetura - permite calcular rotas reais de origem -> destino sem
// depender de nenhuma infraestrutura extra (só Postgres + Prisma).
// ---------------------------------------------------------------------------

model TransitStop {
  id        String   @id @default(uuid())
  name      String
  latitude  Float
  longitude Float

  lineStops LineStop[]

  @@map("transit_stops")
}

model TransitLine {
  id        String   @id @default(uuid())
  code      String   @unique // ex.: "301"
  name      String            // ex.: "Terminal -> Univap"
  createdAt DateTime @default(now()) @map("created_at")

  stops LineStop[]

  @@map("transit_lines")
}

// Associação linha <-> parada, com a ordem (sequence) em que a parada
// aparece no trajeto da linha. Usada pelo algoritmo de busca de rotas para
// garantir que o embarque aconteça antes do desembarque no sentido correto.
model LineStop {
  id            String @id @default(uuid())
  lineId        String @map("line_id")
  stopId        String @map("stop_id")
  sequence      Int // ordem da parada dentro da linha (0, 1, 2...)
  minutesFromStart Int @map("minutes_from_start") // tempo estimado desde a primeira parada

  line TransitLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stop TransitStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([lineId, sequence])
  @@index([stopId])
  @@map("line_stops")
}
