# Ambiente
NODE_ENV=development
PORT=3333

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/guiamobi?schema=public"

# JWT
JWT_SECRET="troque-este-valor-por-um-segredo-forte-em-producao"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_RESET_EXPIRES_IN="30m"

# CORS - origens permitidas separadas por vírgula (use * apenas em desenvolvimento)
CORS_ORIGIN="*"

# E-mail (recuperação de senha) - SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GuiaMobi Acessível <no-reply@guiamobi.com>"

# URL do app mobile usada no link de redefinição de senha (deep link)
APP_RESET_PASSWORD_URL="guiamobi://redefinir-senha"

# Busca de endereços (Nominatim/OpenStreetMap). A política de uso do serviço público
# exige identificar a aplicação: informe um e-mail ou site de contato do projeto.
# Para uso intenso, aponte GEOCODING_BASE_URL para uma instância própria.
GEOCODING_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODING_CONTACT=""

# Origem dos dados de linhas exibida em /transit/status ("seed" = dados de demonstração)
TRANSIT_DATA_SOURCE="seed"

# Ligue como "true" apenas em ambiente local/demonstração para a busca de rotas
# também considerar as linhas de demonstração (não oficiais). Deixe "false"
# (ou remova a variável) em produção e em qualquer ambiente com usuários reais.
ALLOW_DEMO_TRANSIT_DATA="false"

# ---- Transporte público (US06) ----
# Qual fonte usar: auto (padrão: OTP se configurado > GTFS oficial importado > fixture de desenvolvimento),

# ou forçar: google | otp | gtfs | dev
TRANSIT_PROVIDER="dev"
# Cenário de teste local da US06: normal | delayed-101 | unavailable-101
MOCK_TRANSIT_SCENARIO="normal"
# Google Maps Platform Routes API - chave SOMENTE no backend. Requer billing/quota configurados.
GOOGLE_ROUTES_API_KEY=""
# URL da SUA instância do OpenTripPlanner (precisa ter sido iniciada com OSM + GTFS de SJC). Vazio = não usa OTP.
OTP_URL=""
# Feeds GTFS-Realtime (protobuf) - só existem após credenciamento na Prefeitura. Vazios = sem tempo real (nada é inventado).
GTFS_REALTIME_TRIP_UPDATES_URL=""
GTFS_REALTIME_VEHICLE_POSITIONS_URL=""
GTFS_REALTIME_SERVICE_ALERTS_URL=""
# Overpass API (OpenStreetMap) para pontos de referência da US09
OVERPASS_URL="https://overpass-api.de/api/interpreter"
