    "dotenv": "^18.0.1",
    "fastify": "^4.28.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "nodemailer": "^6.9.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.16",
