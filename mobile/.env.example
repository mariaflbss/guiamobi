# URL base da API do GuiaMobi
EXPO_PUBLIC_API_URL=http://localhost:3333

# Contatos exibidos na tela Ajuda (opcionais). Enquanto estiverem vazios, a tela
# informa que o contato ainda não foi configurado, sem inventar dados.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=

# Mapa (US09): o mapa online usa react-native-maps no Expo Go.
# O cache offline usa tiles OSM baixados previamente e exige um Referer válido.
# Em produção, use o site/repositório real do projeto.
EXPO_PUBLIC_MAP_REFERER_URL=https://guiamobi.app/

# A voz neural usa a API do backend; não coloque a chave do Google neste arquivo.
# Configure GOOGLE_TTS_API_KEY somente no .env do diretório api.
